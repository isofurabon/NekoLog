{
    "lock": true,
    "tasks": {
        "dev": "deno run -A vite",
        "start": "deno run --allow-read --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost server.ts",
        "preview": "deno run -A vite preview",
        "storybook": "deno run -A npm:storybook@^10.0.0 dev -p 6006",
        "test": "deno task lint && deno task test:unit && deno task build",
        "test:unit": "deno run -A vitest run",
        "test:watch": "deno run -A vitest",
        "test:e2e": "deno run -A npm:@playwright/test@^1.52.0 test",
        "test:e2e:ui": "deno run -A npm:@playwright/test@^1.52.0 test --ui",
        "test:all": "deno task test:unit && deno task test:e2e",
        "build": "deno task build:licenses && deno run -A vite build",
        "build:licenses": "deno run -A scripts/generate_licenses.ts",
        "rebuild": "deno task clean && deno task build",
        "lint": "deno lint",
        "clean": "deno run -A npm:rimraf@^6.1.2 dist bin playwright-report test-results .vite",
        "compile": "deno compile --allow-read --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost --include dist --output bin/nekolog server.ts",
        "compile:win": "deno compile --allow-read --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost --include dist --output bin/win/nekolog.exe --target x86_64-pc-windows-msvc server.ts",
        "compile:mac": "deno compile --allow-read --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost --include dist --output bin/mac/nekolog --target x86_64-apple-darwin server.ts",
        "compile:mac-arm": "deno compile --allow-read --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost --include dist --output bin/mac-arm/nekolog --target aarch64-apple-darwin server.ts",
        "compile:linux": "deno compile --allow-read --allow-env --allow-run --allow-sys --allow-net=0.0.0.0,127.0.0.1,localhost --include dist --output bin/linux/nekolog --target x86_64-unknown-linux-gnu server.ts",
        "compile:all": "deno task compile:win && deno task compile:mac && deno task compile:mac-arm && deno task compile:linux",
        "ci": "dagger call -m dagger ci --source ."
    },
    "imports": {
        "@/components/": "./src/components/",
        "@/hooks/": "./src/hooks/",
        "@/constants/": "./src/constants/",
        "@/utils/": "./src/utils/",
        "@/types": "./src/types/index.ts",
        "@/store": "./src/store/index.ts",
        "@yume-chan/adb": "npm:@yume-chan/adb@^2.5.1",
        "@yume-chan/adb-credential-web": "npm:@yume-chan/adb-credential-web@^2.1.0",
        "@yume-chan/adb-daemon-webusb": "npm:@yume-chan/adb-daemon-webusb@^2.3.2",
        "@yume-chan/stream-extra": "npm:@yume-chan/stream-extra@^2.1.0",
        "clsx": "npm:clsx@^2.1.1",
        "hono": "npm:hono@^4.11.8",
        "jotai": "npm:jotai@^2.16.2",
        "lucide-react": "npm:lucide-react@^1.0.0",
        "motion": "npm:motion@^13.0.0",
        "open": "npm:open@^11.0.0",
        "react": "npm:react@^19.2.0",
        "react-dom": "npm:react-dom@^19.2.0",
        "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
        "@tanstack/react-virtual": "npm:@tanstack/react-virtual@^3.11.2",
        "tailwind-merge": "npm:tailwind-merge@^3.4.0",
        "tailwindcss": "npm:tailwindcss@^4.1.18",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.0",
        "babel-plugin-react-compiler": "npm:babel-plugin-react-compiler@^1.0.0",
        "vite": "npm:vite@^8.0.0",
        "@eslint/js": "npm:@eslint/js@^10.0.0",
        "eslint": "npm:eslint@^10.0.0",
        "eslint-plugin-react-hooks": "npm:eslint-plugin-react-hooks@^7.0.1",
        "eslint-plugin-react-refresh": "npm:eslint-plugin-react-refresh@^0.5.0",
        "globals": "npm:globals@^17.0.0",
        "vitest": "npm:vitest@^5.0.0",
        "jsdom": "npm:jsdom@^30.0.0",
        "@testing-library/react": "npm:@testing-library/react@^16.3.0",
        "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^7.0.0",
        "@testing-library/user-event": "npm:@testing-library/user-event@^14.6.1",
        "@playwright/test": "npm:@playwright/test@^1.52.0",
        "vite-plugin-pwa": "npm:vite-plugin-pwa@^1.0.0",
        "@types/node": "npm:@types/node@^26.0.0",
        "@types/react": "npm:@types/react@^19.2.5",
        "@types/react-dom": "npm:@types/react-dom@^19.2.3",
        "@types/w3c-web-usb": "npm:@types/w3c-web-usb@^1.0.10",
        "@std/path": "jsr:@std/path@^1.0.8",
        "storybook": "npm:storybook@^8.5.3",
        "@storybook/react": "npm:@storybook/react@^10.0.0",
        "@storybook/react-vite": "npm:@storybook/react-vite@^10.0.0",
        "@storybook/addon-essentials": "npm:@storybook/addon-essentials@^8.5.3",
        "@storybook/addon-interactions": "npm:@storybook/addon-interactions@^8.5.3",
        "@storybook/blocks": "npm:@storybook/blocks@^8.5.3",
        "@storybook/test": "npm:@storybook/test@^8.5.3"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": [
            "deno.window",
            "dom"
        ]
    },
    "nodeModulesDir": "auto"
}